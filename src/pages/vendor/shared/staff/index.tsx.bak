import { useEffect, useState } from "react";
import { toast } from "react-toastify";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import { formatDate } from "@/utils/formatDate";
import {
  ChevronRight,
  Filter,
  Loader2,
  Search,
  X,
  Users,
  Download,
  MoreVertical,
  Eye,
  EyeOff,
} from "lucide-react";
import { PeopleIcon } from "@/components/icons/icons";
import { StatCard } from "@/components/Statcard";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Skeleton } from "@/components/ui/skeleton";
import { Card, CardHeader, CardContent, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { useSearchParams, useNavigate, useRouteMatch } from "react-router-dom";
import { staffService } from "@/services/staff.service";
import { useDispatch } from "react-redux";
import { resetStaff } from "@/redux/store";
import { useParams } from "react-router-dom";

const StaffManagementSystem = () => {
  const { vertical } = useParams();
  const match = useRouteMatch();
  const [activeTab, setActiveTab] = useState("all-staff");
  const [isLoading, setIsLoading] = useState(true);
  const [showModal, setShowModal] = useState(false);
  const [showAdvanced, setShowAdvanced] = useState(false);
  const [filterTab, setFilterTab] = useState("all");
  const [searchTerm, setSearchTerm] = useState("");
  const [filterStatus, setFilterStatus] = useState("all");
  const [filterRole, setFilterRole] = useState("all");
  const [filterShift, setFilterShift] = useState("all");
  const itemsPerPage = 10;
  const [currentPage, setCurrentPage] = useState(1);

  const [formData, setFormData] = useState({
    fullName: "",
    phone: "",
    email: "",
    staffId: "",
    role: "waiter",
  });

  const [staff, setStaff] = useState([]);
  const [allStaff, setAllStaff] = useState([]);
  const [shifts, setShifts] = useState([]);
  const [activityLogs, setActivityLogs] = useState([]);
  const [reports, setReports] = useState([]);

  useEffect(() => {
    async function fetchStaffs() {
      setIsLoading(true);
      try {
        const items = await staffService.getStaff();
        const data = items.docs || [];
        setAllStaff(data);
        setStaff(data);
      } catch (error) {
        console.error(error);
        toast.error("Failed to fetch staff");
      } finally {
        setIsLoading(false);
      }
    }
    fetchStaffs();
  }, []);

  // Filter staff based on active tab
  const filteredStaff = staff.filter((s) => {
    const matchesTab =
      activeTab === "all-staff"
        ? true
        : activeTab === "active-staff"
          ? s.status === "active"
          : activeTab === "invited-staff"
            ? s.status === "invited"
            : activeTab === "suspended-staff"
              ? s.status === "suspended"
              : true;

    const matchesSearch =
      s.name?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      s.email?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      s.staffId?.toLowerCase().includes(searchTerm.toLowerCase());

    const matchesRole = filterRole === "all" || s.role === filterRole;
    const matchesStatus = filterStatus === "all" || s.status === filterStatus;
    const matchesShift =
      filterShift === "all"
        ? true
        : s.onShift !== undefined
          ? s.onShift
          : filterShift === "on-shift"
            ? true
            : false;

    return (
      matchesTab &&
      matchesSearch &&
      matchesRole &&
      matchesStatus &&
      matchesShift
    );
  });

  const totalPages = Math.ceil(filteredStaff.length / itemsPerPage);
  const paginatedStaff = filteredStaff.slice(
    (currentPage - 1) * itemsPerPage,
    currentPage * itemsPerPage
  );

  // Stats
  const stats = {
    total: allStaff.length,
    active: allStaff.filter((s) => s.status === "active").length,
    invited: allStaff.filter((s) => s.status === "invited").length,
    suspended: allStaff.filter((s) => s.status === "suspended").length,
  };

  if (isLoading) {
    return (
      <div className="p-8 space-y-6">
        <Card>
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-2xl font-bold tracking-tight">Staff List</CardTitle>
          </CardHeader>
          <div className="p-6">
            <Skeleton className="h-8 w-48" />
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              {[Array(4)].map((_, i) => (
                <Skeleton key={i} className="h-24 w-full" />
              ))}
            </div>
            <Skeleton className="h-96 w-full" />
          </div>
        </Card>
      </div>
    );
  }

  // Tab rendering
  const tabLabels = [
    { key: "all-staff", label: `All Staff (${stats.total})` },
    { key: "active-staff", label: `Active (${stats.active})` },
    { key: "invited-staff", label: `Invited (${stats.invited})` },
    { key: "suspended-staff", label: `Suspended (${stats.suspended})` },
  ];

  const getStatusVariant = (status: any) => {
    switch (status) {
      case "active":
        return "default";
      case "invited":
        return "secondary";
      case "suspended":
        return "destructive";
      default:
        return "outline";
    }
  };

  const getInitials = (name: string) =>
    name
      ? name
          .split(" ")
          .map((n) => n[0])
          .join("")
          .toUpperCase()
          .slice(0, 2)
      : "";

  // Tab buttons
  const tabButtons = tabLabels.map(({ key, label }) => (
    <Button key={key} variant={activeTab === key ? "default" : "outline"} onClick={() => setActiveTab(key)} className="px-4 py-2 mr-2">
      {label}
    </Button>
  ));

  // Modal for Add Staff
  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
  };

  const handleSaveStaff = async () => {
    const newStaff = {
      name: formData.fullName,
      phone: formData.phone,
      email: formData.email,
      staffId: formData.staffId,
      role: formData.role,
      status: "active",
    };

    try {
      const res = await staffService.createStaff(newStaff);
      setAllStaff((prev) => [...prev, res]);
      setStaff((prev) => [...prev, res]);
      toast.success("Staff added successfully");
      setShowModal(false);
      setFormData({
        fullName: "",
        phone: "",
        email: "",
        staffId: "",
        role: "waiter",
      });
    } catch (error) {
      toast.error("Failed to add staff");
    }
  };

  // Resend Invite
  const handleResendInvite = async (staffId: string) => {
    try {
      await staffService.resendInvite(staffId);
      toast.success("Invitation email sent");
    } catch (error) {
      toast.error("Failed to resend invitation");
    }
  };

  // Revoke Access
  const handleRevokeAccess = async (staffId: string) => {
    try {
      await staffService.revokeStaffAccess(staffId);
      setAllStaff((prev) =>
        prev.map((s) => (s._id === staffId ? { ...s, status: "suspended" } : s))
      );
      toast.success("Staff access revoked");
    } catch (error) {
      toast.error("Failed to revoke access");
    }
  };

  // Edit Role
  const handleEditRole = async (staffId: string, newRole: string) => {
    try {
      const staff = allStaff.find((s) => s._id === staffId);
      if (!staff) return;
      staff.role = newRole;
      toast.success("Role updated");
    } catch (error) {
      toast.error("Failed to update role");
    }
  };

  // Reports data
  const generateReportsData = () => {
    return [
      { label: "Sales Volume", value: "$12,540", trend: "up", icon: "TrendingUp" },
      { label: "Avg Prep Speed", value: "12 min", trend: "down", icon: "Timer" },
      { label: "Order Voids", value: "24", trend: "up", icon: "AlertCircle" },
      { label: "Staff Attendance", value: "95%", trend: "up", icon: "Users" },
    ];
  };

  return (
    <div className="p-6 md:p-8 space-y-6">
      {/* Header with tabs */}
      <div className="flex flex-col md:flex-row gap-4">
        {/* Tabs */}
        <div className="flex gap-2 flex-1">
          {tabButtons}
        </div>

        {/* Add Staff Button */}
        <Button
          variant="primary"
          size="sm"
          onClick={() => setShowModal(true)}
          className="bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700"
        >
          <Users className="w-4 h-4 mr-1" />+ New Staff
        </Button>
      </div>

      {/* Stats */}
      {showModal || activeTab !== "all-staff" ? (
        <div className="hidden md:block">
          <Card className="shadow-lg">
            <CardHeader className="flex flex-row items-center justify-between pb-2">
              <CardTitle className="text-2xl font-bold tracking-tight">Staff List</CardTitle>
            </CardHeader>
            <CardContent className="p-6">
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <StatCard
                  title="Total Staff"
                  value={stats.total}
                  change={12}
                  trend="up"
                  icon={PeopleIcon}
                  iconBg="bg-blue-100"
                  iconColor="text-blue-600"
                />
                <StatCard
                  title="Active Staff"
                  value={stats.active}
                  change={8}
                  trend="up"
                  icon={PeopleIcon}
                  iconBg="bg-green-100"
                  iconColor="text-green-600"
                />
                <StatCard
                  title="Invited Staff"
                  value={stats.invited}
                  change={5}
                  trend="up"
                  icon={PeopleIcon}
                  iconBg="bg-orange-100"
                  iconColor="text-orange-600"
                />
                <StatCard
                  title="Suspended Staff"
                  value={stats.suspended}
                  change={3}
                  trend="down"
                  icon={PeopleIcon}
                  iconBg="bg-red-100"
                  iconColor="text-red-600"
                />
              </div>
            </CardContent>
          </Card>
        </div>
      ) : (
        <Card className="shadow-lg">
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-2xl font-bold tracking-tight">Staff List</CardTitle>
          </CardHeader>
          <CardContent className="p-6">
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              <StatCard
                title="Total Staff"
                value={stats.total}
                change={12}
                trend="up"
                icon={PeopleIcon}
                iconBg="bg-blue-100"
                iconColor="text-blue-600"
              />
              <StatCard
                title="Active Staff"
                value={stats.active}
                change={8}
                trend="up"
                icon={PeopleIcon}
                iconBg="bg-green-100"
                iconColor="text-green-600"
              />
              <StatCard
                title="Invited Staff"
                value={stats.invited}
                change={5}
                trend="up"
                icon={PeopleIcon}
                iconBg="bg-orange-100"
                iconColor="text-orange-600"
              />
              <StatCard
                title="Suspended Staff"
                value={stats.suspended}
                change={3}
                trend="down"
                icon={PeopleIcon}
                iconBg="bg-red-100"
                iconColor="text-red-600"
              />
            </div>
          </CardContent>
        </Card>
      )}

      {/* Tabs Content */}
      <div className="mt-6 grid gap-6">
        {/* ALL STAFF TAB */}
        {activeTab === "all-staff" && (
          <Card>
            <CardHeader>
              <CardTitle>All Staff</CardTitle>
            </CardHeader>
            <CardContent className="p-0">
              <div className="p-4 border-b border-gray-200">
                <div className="flex flex-col sm:flex-row gap-2">
                  <Select value={filterRole} onValueChange={setFilterRole}>
                    <SelectTrigger className="w-[160px]">
                      <SelectValue placeholder="Filter by role" />
                      <SelectContent>
                        <SelectItem value="all">All roles</SelectItem>
                        <SelectItem value="waiter">Waiter</SelectItem>
                        <SelectItem value="chef">Chef</SelectItem>
                        <SelectItem value="bartender">Bartender</SelectItem>
                        <SelectItem value="vip_host">VIP Host</SelectItem>
                        <SelectItem value="front_desk">Front Desk</SelectItem>
                        <SelectItem value="housekeeping">Housekeeping</SelectItem>
                        <SelectItem value="manager">Manager</SelectItem>
                      </SelectContent>
                    </SelectTrigger>
                  </Select>
                  <Input
                    placeholder="Search by name or email..."
                    value={searchTerm}
                    onChange={(e) => setSearchTerm(e.target.value)}
                    className="pl-3"
                  />
                  <Select value={filterStatus} onValueChange={setFilterStatus}>
                    <SelectTrigger className="w-[140px]">
                      <SelectValue placeholder="Status" />
                      <SelectContent>
                        <SelectItem value="all">All</SelectItem>
                        <SelectItem value="active">Active</SelectItem>
                        <SelectItem value="invited">Invited</SelectItem>
                        <SelectItem value="suspended">Suspended</SelectItem>
                      </SelectContent>
                    </SelectTrigger>
                  </Select>
                  <Select value={filterShift} onValueChange={setFilterShift}>
                    <SelectTrigger className="w-[120px]">
                      <SelectValue placeholder="Shift" />
                      <SelectContent>
                        <SelectItem value="all">All</SelectItem>
                        <SelectItem value="on-shift">On Shift</SelectItem>
                        <SelectItem value="off-shift">Off Shift</SelectItem>
                      </SelectContent>
                    </SelectTrigger>
                  </Select>
                  <Button variant="outline" size="sm">
                    <Filter className="w-4 h-4 mr-2" /> Advanced
                  </Button>
                </div>
              </div>

              {paginatedStaff.length === 0 ? (
                <div className="flex flex-col items-center justify-center p-12 text-center">
                  <Users className="w-12 h-12 text-muted-foreground mb-4" />
                  <h3 className="text-lg font-semibold mb-2">No staff found</h3>
                  <p className="text-muted-foreground mb-6">
                    Try adjusting your search or filter criteria.
                  </p>
                  <Button onClick={() => setShowModal(true)}>+ Add your first staff</Button>
                </div>
              ) : (
                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead className="w-[50px]" />
                      <TableHead>Staff</TableHead>
                      <TableHead>Phone</TableHead>
                      <TableHead>Email</TableHead>
                      <TableHead>Role</TableHead>
                      <TableHead>Status</TableHead>
                      <TableHead className="text-right">Actions</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {paginatedStaff.map((member) => (
                      <TableRow key={member._id}>
                        <TableCell>
                          <input type="checkbox" className="rounded border-gray-300" />
                        </TableCell>
                        <TableCell className="font-medium">
                          <div className="flex items-center gap-3">
                            <div className="w-10 h-10 rounded-full bg-gradient-to-br from-teal-500 to-blue-600 flex items-center justify-center text-white font-medium text-sm">
                              {getInitials(member.name)}
                            </div>
                            <div>
                              <div className="font-medium">{member.name}</div>
                              <div className="text-sm text-muted-foreground">{member.staffId}</div>
                            </div>
                          </div>
                        </TableCell>
                        <TableCell className="font-medium">{member.phone}</TableCell>
                        <TableCell>
                          <div className="max-w-[200px] truncate" title={member.email}>
                            {member.email}
                          </div>
                        </TableCell>
                        <TableCell>
                          <Badge variant="default">
                            {member.role}
                          </Badge>
                        </TableCell>
                        <TableCell>{formatDate(member.createdAt)}</TableCell>
                        <TableCell className="text-right">
                          <div className="flex items-center gap-2">
                            <Button
                              variant="ghost"
                              size="sm"
                              onClick={() => handleResendInvite(member._id)}
                            >
                              <ChevronRight className="w-3 h-3" />
                            </Button>
                            <Button
                              variant="ghost"
                              size="sm"
                              onClick={() => handleRevokeAccess(member._id)}
                            >
                              <X className="w-3 h-3" />
                            </Button>
                            <Button
                              variant="ghost"
                              size="sm"
                              onClick={() => handleEditRole(member._id, "waiter")}
                            >
                              <MoreVertical className="w-3 h-3" />
                            </Button>
                          </div>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              )}
            </CardContent>
          </Card>
        )}

        {/* SHIFT MANAGER TAB */}
        {activeTab === "shift-manager" && (
          <Card>
            <CardHeader>
              <CardTitle>Shift Manager</CardTitle>
            </CardHeader>
            <CardContent className="p-6">
              <p className="text-muted-foreground mb-4">
                Assign active staff to floor zones, tables, or room blocks for the day.
              </p>

              {/* Staff Assignment Board */}
              <div className="overflow-x-auto">
                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead>Staff Member</TableHead>
                      <TableHead>Role</TableHead>
                      <TableHead>Assigned Zone/Table/Room</TableHead>
                      <TableHead>On Shift</TableHead>
                      <TableHead className="text-right">Actions</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {filteredStaff.map((member) => (
                      <TableRow key={member._id}>
                        <TableCell className="font-medium">
                          <div className="flex items-center gap-3">
                            <div className="w-8 h-8 rounded-full bg-gradient-to-br from-teal-500 to-blue-600 flex items-center justify-center text-white font-medium text-sm">
                              {getInitials(member.name)}
                            </div>
                            <div>
                              <div className="font-medium">{member.name}</div>
                              <div className="text-sm text-muted-foreground">{member.role}</div>
                            </div>
                          </div>
                        </TableCell>
                        <TableCell>
                          <Badge variant="default">
                            {member.role}
                          </Badge>
                        </TableCell>
                        <TableCell>
                          <Input placeholder="Zone/Table/Room" value="" onChange={()} className="w-full" />
                        </TableCell>
                        <TableCell>
                          <Button variant="ghost" size="sm" onClick={() => {}}>
                            {member.onShift ? "Clock Out" : "Clock In"}
                          </Button>
                        </TableCell>
                        <TableCell className="text-right">
                          <Button variant="outline" size="sm">Save Assignment</Button>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </div>

              {/* Quick Assignment Section */}
              <div className="mt-6 pt-6 border-t border-gray-200">
                <h4 className="font-medium mb-3">Quick Assignment</h4>
                <div className="grid grid-cols-2 gap-3">
                  <Select value="table" onValueChange={(v) => {}} />
                  <SelectValue placeholder="Table" />
                  <Select value="room" onValueChange={(v) => {}} />
                  <SelectValue placeholder="Room" />
                </div>
                <Button variant="outline" size="sm" onClick={() => {}} className="mt-2 w-full">
                  Assign Selected
                </Button>
              </div>
            </CardContent>
          </Card>
        )}

        {/* ACTIVITY TRACKER TAB */}
        {activeTab === "activity-tracker" && (
          <Card>
            <CardHeader>
              <CardTitle>Staff Activity Tracker</CardTitle>
            </CardHeader>
            <CardContent className="p-6">
              <p className="text-muted-foreground mb-4">
                Minute-by-minute log of key actions taken on the floor.
              </p>

              {activityLogs.length === 0 ? (
                <div className="h-64 flex items-center justify-center text-muted-foreground">
                  <Loader2 className="w-8 h-8 mr-3" /> No activity logged yet
                </div>
              ) : (
                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead>Time</TableHead>
                      <TableHead>Staff</TableHead>
                      <TableHead>Action</TableHead>
                      <TableHead>Entity</TableHead>
                      <TableHead>Details</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {activityLogs.map((log, index) => (
                      <TableRow key={index}>
                        <TableCell>
                          <div className="text-xs text-muted-foreground">
                            {log.at ? new Date(log.at).toLocaleTimeString() : "—"}
                          </div>
                        </TableCell>
                        <TableCell className="font-medium">
                          {log.actorName || "—"}
                        </TableCell>
                        <TableCell>
                          <div className="truncate max-w-xs">{log.action || "—"}</div>
                        </TableCell>
                        <TableCell>{log.entityName || "—"}</TableCell>
                        <TableCell>
                          <div className="truncate max-w-md">{log.metadata || "—"}</div>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              )}
            </CardContent>

            {/* Activity Filter */}
            <div className="mt-4 p-3 bg-gray-50 rounded">
              <Select value="all" onValueChange={(v) => {}}>
                <SelectTrigger>
                  <SelectValue placeholder="Filter by date" />
                  <SelectContent>
                    <SelectItem value="all">Today</SelectItem>
                    <SelectItem value="yesterday">Yesterday</SelectItem>
                    <SelectItem value="this-week">This Week</SelectItem>
                  </SelectContent>
                </SelectTrigger>
              </Select>
              <Button variant="outline" size="sm" className="ml-2">
                Refresh
              </Button>
            </div>
          </Card>
        )}

        {/* REPORTS & ANALYTICS TAB */}
        {activeTab === "reports" && (
          <Card>
            <CardHeader>
              <CardTitle>Reports & Analytics</CardTitle>
            </CardHeader>
            <CardContent className="p-6">
              <p className="text-muted-foreground mb-6">
                Performance metrics to assess productivity, speed, and sales contribution.
              </p>

              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                {generateReportsData().map((item, index) => (
                  <Card key={index} className="p-4">
                    <CardContent>
                      <div className="flex items-center justify-between">
                        <span className="text-sm text-muted-foreground">{item.label}</span>
                        <span className="text-xl font-bold">{item.value}</span>
                      </div>
                      <p className="text-xs text-muted-foreground mt-1">{item.trend}</p>
                    </CardContent>
                  </Card>
                ))}
              </div>

              {/* Filters */}
              <div className="mb-6">
                <div className="grid grid-cols-2 gap-3 mb-3">
                  <Select placeholder="Date From" className="w-40" />
                  <Select placeholder="Date To" className="w-40" />
                  <Select placeholder="Branch" className="w-40" />
                  <Select placeholder="Staff" className="w-40" />
                </div>
                <Button variant="outline" size="sm">Apply Filters</Button>
              </div>

              {/* Core Metrics */}
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <Card className="p-4">
                  <CardContent>
                    <h4 className="font-medium mb-2">Sales Volume Generated</h4>
                    <p className="text-2xl font-bold">₦12,540,000</p>
                    <p className="text-sm text-muted-foreground">NGN</p>
                  </CardContent>
                </Card>
                <Card className="p-4">
                  <CardContent>
                    <h4 className="font-medium mb-2">Table/Room Turnover</h4>
                    <p className="text-2xl font-bold">4.2 avg</p>
                    <p className="text-sm text-muted-foreground">per staff</p>
                  </CardContent>
                </Card>
                <Card className="p-4">
                  <CardContent>
                    <h4 className="font-medium mb-2">Kitchen Prep Speed</h4>
                    <p className="text-2xl font-bold">12 min</p>
                    <p className="text-sm text-muted-foreground">avg</p>
                  </CardContent>
                </Card>
                <Card className="p-4">
                  <CardContent>
                    <h4 className="font-medium mb-2">Order Void & Refund</h4>
                    <p className="text-2xl font-bold">24</p>
                    <p className="text-sm text-muted-foreground">frequency</p>
                  </CardContent>
                </Card>
              </div>
            </CardContent>
          </Card>
        )}
      </div>
    </div>
  );
};

export default StaffManagementSystem;